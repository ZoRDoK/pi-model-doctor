{
  "name": "pi-model-doctor",
  "version": "1.1.0",
  "description": "pi extension: /model-doctor — reconciles OpenRouter, OpenCode, OpenCode Go and any OpenAI/Anthropic/Gemini-compatible provider you configured into models.json. One safe atomic pass, no guessed limits.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "model-catalog",
    "openrouter",
    "opencode"
  ],
  "license": "MIT",
  "author": "ZoRDoK",
  "files": [
    "src",
    "assets",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ZoRDoK/pi-model-doctor"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
